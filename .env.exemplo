# Modelo do arquivo .env — este arquivo VAI para o Git; o .env de verdade NÃO vai.
# Para usar: copie este arquivo com o nome .env e preencha os valores.

# Chave que assina o cookie de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use uma chave diferente no computador e no servidor. Nunca compartilhe.
SECRET_KEY=

# 1 = modo debug ligado (só no computador!)   0 = desligado (sempre no servidor)
FLASK_DEBUG=1

# 1 = o cookie de login só viaja por HTTPS. Use 1 no servidor; 0 no computador
# (no computador o endereço é http://127.0.0.1, sem HTTPS — com 1 o login não funcionaria)
SESSAO_SOMENTE_HTTPS=0
